{
    "name": "SDO MIREA CUSTOMIZE",
    "description": "Расширение для тёмной темы и возможности сменить логотип СДО МИРЭА",
    "version": "1.0",
    "manifest_version": 3,
    "icons": {
        "16": "icons/16.png",
        "32": "icons/32.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "action": {
        "default_popup": "popup/popup.html"
    },
    "permissions": ["scripting", "activeTab", "storage"],
    "host_permissions": [
        "*://online-edu.mirea.ru/*"
    ],
    "background": {
        "service_worker": "js/background.js"
    },
    "content_scripts": [
        {
            "matches": ["*://online-edu.mirea.ru/*"],
            "js": ["js/content.js"],
            "css": ["css/style.css"],
            "run_at": "document_start"
        }
    ]
}